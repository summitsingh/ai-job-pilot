            if a.dry_run:
                result["dry_run"] = True
            log("EXCEPTION:", e)
        try:
            json.dump(result, open(os.path.join(work, "result.json"), "w"),
                      indent=1)
            terminal = finish_job(job, result, cfg)
        except OSError as e:
            # Finalization itself failed: release so the job is not stuck
            # claimed, and keep the error loud.
