    @staticmethod
    def _clip(value, limit=2000):
        s = str(value or "")
        return s if len(s) <= limit else s[:limit - 1] + "\u2026"

    def _prop(self, name, value, ptype="rich_text"):
        if ptype == "title":
            return {name: {"title": [{"text": {
                "content": self._clip(value)}}]}}
        if ptype == "url":
            return {name: {"url": value or None}}
        if ptype == "date":
