    heartbeat(cfg["claims"], job["url"], cfg["lane"])
    out["watchdog"] = {"ladder": wd["ladder"], "evidence": wd["evidence"]}
    snippet = wd["evidence"].get("page_snippet", "")
    if wd["outcome"] == "code-gate":
        out.update(status="code-gate",
